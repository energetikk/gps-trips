# Скопируйте в .env и поменяйте значения. Файл .env в git не попадает.

# Токен устройства: тот же, что в приложении в настройке «Передача координат».
TRACK_TOKEN=please-change-me-to-a-long-random-string

# Необязательный пароль на просмотр карты и /api/last.
VIEW_PASSWORD=

# Необязательный ключ JavaScript API Яндекс.Карт для интерактивной карты.
# Без него карта тоже работает, но ключ надёжнее и соответствует условиям Яндекса.
# YMAPS_JS_KEY=

# Порт, который Nginx слушает на VPS (перед ним обычно ещё ваш HTTPS-прокси).
HTTP_PORT=8080

# Необязательно: пути к файлам данных. По умолчанию /data/state.json и
# /data/trips.json — их создаёт Docker-том state.
# STATE_FILE=/data/state.json
# TRIPS_FILE=/data/trips.json
